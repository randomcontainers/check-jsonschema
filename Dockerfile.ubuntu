# syntax=docker/dockerfile:1.27.0@sha256:bde3983e9c939224420ddaf6b784cc30e09b035a4dea01f581230c50809f372e
# check=error=true

ARG BASE_IMAGE=ubuntu:26.04

FROM ${BASE_IMAGE} AS build
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*

ARG VERSION
# The license in package.yml covers the license files of the vendored schemas
# in schema-licenses.sha256; the build stops when a release adds, removes or
# changes one of them.
RUN --mount=type=bind,target=/src \
    set -eu; \
    : "${VERSION:?}"; \
    if ! awk -v want="check-jsonschema==${VERSION}" '$1 == want { found = 1 } END { exit !found }' /src/requirements.lock; then \
        echo "requirements.lock does not pin check-jsonschema==${VERSION}" >&2; exit 1; \
    fi; \
    venv=/usr/local/lib/check-jsonschema; \
    meta=/usr/local/share/randomcontainers/check-jsonschema; \
    python3 -m venv "$venv"; \
    "$venv/bin/pip" install --no-cache-dir --disable-pip-version-check --no-input \
        --require-hashes --no-deps --only-binary=:all: \
        --report /tmp/pip-report.json -r /src/requirements.lock; \
    installed="$("$venv/bin/check-jsonschema" --version)"; \
    if [ "$installed" != "check-jsonschema, version ${VERSION}" ]; then \
        echo "requirements.lock installs $installed, expected check-jsonschema ${VERSION}" >&2; exit 1; \
    fi; \
    ln -s "$venv/bin/check-jsonschema" /usr/local/bin/check-jsonschema; \
    mkdir -p "$meta"; \
    printf '%s\n' "$VERSION" > "$meta/version"; \
    cp /src/runtime-deps.ubuntu "$meta/runtime-deps"; \
    "$venv/bin/python" /src/scripts/metadata.py /tmp/pip-report.json "$meta" /src/licenses; \
    rm /tmp/pip-report.json; \
    "$venv/bin/python" /src/scripts/check-libraries.py; \
    vendor="$("$venv/bin/python" -c 'import os, check_jsonschema.builtin_schemas.vendor as m; print(os.path.dirname(m.__file__))')"; \
    for path in "$vendor"/licenses/*; do \
        sum="$(sha256sum < "$path")"; \
        printf '%s  %s\n' "${sum%% *}" "${path##*/}"; \
    done > /tmp/schema-licenses.sha256; \
    if ! diff -u /src/schema-licenses.sha256 /tmp/schema-licenses.sha256 >&2; then \
        echo "the license files of the vendored schemas changed, check the license in package.yml" >&2; exit 1; \
    fi; \
    rm /tmp/schema-licenses.sha256; \
    mkdir "$meta/licenses/check-jsonschema/vendor-schemas"; \
    cp "$vendor"/licenses/* "$vendor/README.md" "$meta/licenses/check-jsonschema/vendor-schemas/"

FROM ${BASE_IMAGE} AS slim
ARG DEBIAN_FRONTEND=noninteractive
RUN --mount=type=bind,source=runtime-deps.ubuntu,target=/tmp/runtime-deps \
    set -eu; \
    apt-get update; \
    xargs apt-get install -y --no-install-recommends ca-certificates tini < /tmp/runtime-deps; \
    rm -rf /var/lib/apt/lists/*; \
    install -d -m 1777 /work /cache
COPY --link --from=build /usr/local/ /usr/local/
ENV LANG=C.UTF-8 XDG_CACHE_HOME=/cache PYTHONUNBUFFERED=1
WORKDIR /work
USER 1000:1000
ENTRYPOINT ["tini", "--", "check-jsonschema"]
CMD ["--help"]
